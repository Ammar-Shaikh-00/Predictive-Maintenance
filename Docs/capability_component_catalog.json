      "drift_baseline_loaded": "bool — DriftDetector baseline_stats present",
      "drift_status": "baseline_loaded|no_baseline",
      "expected_ml_states": "same six states as catalog",
      "expected_sensor_channels": "Val_1, Val_5, Val_6, Val_7..11, Val_27..32",
      "prediction_readiness": "number 0-100 or null — SERVING health only, never Accuracy",
      "prediction_readiness_kind": "serving_health_not_accuracy"
    },
    "anomaly_model_states": [
