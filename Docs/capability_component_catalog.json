  "_meta": {
    "role": "single_source_of_truth",
    "file": "Docs/capability_component_catalog.json",
    "usage": [
      "Seed Postgres capability_component table (bootstrap on deploy)",
      "Runtime catalog load if backend reads rules from repo/file instead of stale DB only",
      "AI/ML edits weights, formulas, labels, unlocks here — then re-seed or hot-reload"
    ],
    "do_not_duplicate": "Do not maintain a parallel CSV or hardcoded frontend list. Edit this file only.",
    "backend_seed_path": "Docs/capability_component_catalog.json",
    "runtime_path_env": "CAPABILITY_CATALOG_PATH",
    "docker_mount": "/app/catalogs/capability_component_catalog.json",
    "edit_policy": "AI/ML owns changes; bump spec_version or updated_at on each change",
    "live_monitor_health": "GET {LIVE_MONITOR_URL}/health — default http://localhost:8001/health (edge docker often :9003)"
  },
  "spec_version": "1.1.0",
  "company_id": "default",
  "line_id": "extrusion_01",
  "updated_at": "2026-08-18",
  "owner": "AI/ML",
  "ml_signoff": {
    "component_keys_approved": true,
    "digitalization_weights_sum_100": true,
    "no_accuracy_invented": true,
    "formulas_bound_to_existing_probes": true,
    "models_validated_stays_locked": true,
    "stale_windows_accepted_seconds": [30, 60, 120, 300],
    "notes": "live-monitor /health now exposes classifier_loaded, ml_models_loaded, drift_baseline_loaded, prediction_readiness (serving_health_not_accuracy). Backend implements work_pct_formula literally.",
    "signed_off_by": "AI/ML (live_monitor)",
    "signed_off_at": "2026-08-18"
  },
  "honesty_rules": [
    "Never invent Accuracy %.",
    "Never mix digitalization_progress, work_pct, and model_accuracy.",
    "Never mark a locked source as active.",
    "Every runtime value must carry value_source: LIVE | DERIVED | MODEL_PREDICTION | RULE_BASED | MANUAL.",
    "If a probe fails, status=degraded or locked and work_pct=0 — do not keep the last painted number."
  ],
  "scores": {
    "digitalization_progress": {
      "formula": "sum(weight of components where contributes_to_digitalization=true AND runtime.status in [active, degraded])",
      "max": 100,
      "note": "Connection coverage only. Current live footprint = 55 if five core sources are active."
    },
    "capability_work_index": {
      "formula": "round(sum(weight * work_pct/100) / sum(weight) * 100) for contributes_to_digitalization=true",
      "max": 100,
      "note": "How well connected sources actually work. Optional second ring on the card — default OFF until product asks."
    },
    "ml_serving_index": {
      "formula": "round(mean(work_pct) of category=ml where enabled_in_product=true)",
      "note": "Not Accuracy. Serving health of deployed models only."
    }
  },
  "status_enum": ["active", "degraded", "locked", "not_applicable"],
  "value_source_enum": ["LIVE", "DERIVED", "MODEL_PREDICTION", "RULE_BASED", "MANUAL"],
  "health_bands": {
    "green_min": 80,
    "yellow_min": 40,
    "red_max": 39
  },
  "expected_ml_states": [
    "OFF",
    "HEATING",
    "READY",
    "LOW_PRODUCTION",
    "PRODUCTION",
    "COOLING"
  ],
  "live_monitor": {
    "role": "Inference + probe surface for ML capability rows",
    "health_path": "/health",
    "reload_models_path": "POST /ml/reload-models",
    "retrain": "PC only — python live_monitor/run_retrain.py; never auto-retrain in Docker",
    "health_fields_for_backend": {
      "status": "ok|… — ai_server / live-monitor up",
      "ml_models_loaded": "list[str] anomaly states currently loaded",
      "models_expected": "list[str] all six registry states",
      "models_expected_count": 6,
      "classifier_loaded": "bool — state_classifier.pkl in memory or on disk",
